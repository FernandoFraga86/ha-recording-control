+)
+def get_recording_control_authority(request: Request):
+    """Return the live recording controller generation and startup fences."""
+    dispatcher = request.app.dispatcher
+    if dispatcher is None:
+        return JSONResponse(
+            content={"status": "hold", "reason": "dispatcher_unavailable"},
+            status_code=503,
+        )
+    result = dispatcher.recording_authority_status()
