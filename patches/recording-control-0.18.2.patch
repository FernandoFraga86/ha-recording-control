+            )
+        )
+
+    def test_digest_rejects_malformed_and_duplicate_identities(self) -> None:
+        self.assertIsNone(writer_set_digest([{"pid": 0, "created": 1, "roles": ["record"]}]))
+        self.assertIsNone(writer_set_digest([self.writers[0], self.writers[0]]))
+        self.assertIsNone(writer_set_digest([{"pid": 1, "created": 1, "roles": ["detect"]}]))
+
+    def test_drain_receipt_is_correlated_to_generation_and_barrier(self) -> None:
+        receipt = {
+            "phase": "drain_complete",
+            "operation_id": "private-1",
+            "generation": "generation-1",
+            "camera": "guard",
+            "barrier_id": "barrier-1",
+            "writer_set_digest": self.digest,
+            "worker_instance": "maintainer-1",
+            "cache_clear": True,
+            "inflight_tasks": 0,
+            "maintenance_sequence": 3,
+        }
+        expected = {
+            "operation_id": "private-1",
+            "generation": "generation-1",
+            "camera": "guard",
+            "barrier_id": "barrier-1",
+            "writer_digest": self.digest,
+            "worker_instance": "maintainer-1",
+        }
+        self.assertTrue(validate_drain_receipt(receipt, **expected))
+        for key, value in (("generation", "old-generation"), ("barrier_id", "old-barrier"), ("cache_clear", False)):
+            with self.subTest(key=key):
+                invalid = dict(receipt, **{key: value})
+                self.assertFalse(validate_drain_receipt(invalid, **expected))
+
+    def _new_barrier(self) -> RecordingOffBarrier:
+        return RecordingOffBarrier(
+            "private-1", "generation-1", "guard", self.writers, self.digest
+        )
+
+    def _writer_stop_receipt(self) -> dict:
+        return {
+            "phase": "writers_stopped",
+            "operation_id": "private-1",
+            "generation": "generation-1",
+            "camera": "guard",
+            "worker": "camera_capture",
+            "worker_instance": "capture-1",
+            "enabled": False,
+            "applied": True,
+            "inventory_complete": True,
+            "writer_set_digest": self.digest,
+            "record_processes": [],
+            "writer_exit_receipts": [
+                {**writer, "exit_observed": True, "exit_code": -15}
+                for writer in self.writers
+            ],
+        }
+
+    def test_barrier_enforces_stop_then_drain_order_and_same_generation(self) -> None:
+        protocol = self._new_barrier()
+        premature_drain = {
+            "phase": "drain_complete",
+            "operation_id": "private-1",
+            "generation": "generation-1",
+            "camera": "guard",
+            "barrier_id": "not-issued",
+            "writer_set_digest": self.digest,
+            "worker_instance": "maintainer-1",
+            "cache_clear": True,
+            "inflight_tasks": 0,
+            "maintenance_sequence": 1,
+        }
+        self.assertFalse(
+            protocol.accept_drain_complete(
