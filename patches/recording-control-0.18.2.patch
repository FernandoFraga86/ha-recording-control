+    return JSONResponse(content=result, status_code=status_code)
+
+
+@router.post(
+    "/recordings/control",
+    dependencies=[Depends(require_role(["admin"]))],
+)
+def begin_recording_control(request: Request, body: RecordingControlBody):
+    """Start a correlated recording transition and return its current status."""
+    dispatcher = request.app.dispatcher
+    if dispatcher is None:
+        return JSONResponse(
+            content={"status": "hold", "reason": "dispatcher_unavailable"},
+            status_code=503,
+        )
+    result = dispatcher.begin_recording_control(
+        body.camera,
+        body.enabled,
+        body.operation_id,
+        purpose=body.purpose,
+    )
+    if result.get("status") == "hold":
+        return JSONResponse(content=result, status_code=409)
+    status_code = 200 if result.get("status") == "applied" else 202
+    return JSONResponse(content=result, status_code=status_code)
+
+
+@router.get(
+    "/recordings/control/{operation_id}",
+    dependencies=[Depends(require_role(["admin"]))],
+)
+def get_recording_control_status(request: Request, operation_id: str):
+    """Return current worker evidence for a recording transition."""
+    dispatcher = request.app.dispatcher
+    if dispatcher is None:
+        return JSONResponse(
+            content={"status": "hold", "reason": "dispatcher_unavailable"},
+            status_code=503,
+        )
+    result = dispatcher.recording_control_status(operation_id)
+    if result is None:
+        return JSONResponse(
+            content={"status": "unknown_operation"},
+            status_code=404,
+        )
+    return JSONResponse(content=result)
