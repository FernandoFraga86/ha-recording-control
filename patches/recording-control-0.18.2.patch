+"""Tests for the correlated recording control endpoints."""
+
+from unittest.mock import MagicMock
+
+from frigate.models import Event, Recordings, ReviewSegment
+from frigate.test.http_api.base_http_test import AuthTestClient, BaseTestHttp
+
+
+class TestRecordingControlEndpoints(BaseTestHttp):
+    def setUp(self):
+        super().setUp(models=[Event, Recordings, ReviewSegment])
+        self.app = self.create_app()
+        self.app.dispatcher = MagicMock()
+        self.app.dispatcher.begin_recording_control.return_value = {
+            "status": "pending",
+            "operation_id": "private-operation-1",
+            "camera": "front_door",
+            "enabled": False,
+            "purpose": "privacy",
+            "generation": "frigate-generation-1",
+            "acks": [],
+            "fenced": True,
+        }
+        self.app.dispatcher.recording_control_status.return_value = {
+            "status": "applied",
+            "operation_id": "private-operation-1",
+            "camera": "front_door",
+            "enabled": False,
+            "generation": "frigate-generation-1",
+            "acks": ["camera_capture", "recording_maintainer"],
+            "fenced": True,
+        }
+        self.app.dispatcher.recording_authority_status.return_value = {
+            "status": "ready",
+            "generation": "frigate-generation-1",
+            "dispatcher_identity": {"pid": 10, "created": 1234.5},
+            "fenced_cameras": ["ipc_guardiao_portao"],
+        }
+
+    def test_authority_endpoint_returns_live_generation_and_fences(self):
+        with AuthTestClient(self.app) as client:
+            response = client.get("/recordings/control/authority")
+
+        self.assertEqual(response.status_code, 200)
+        self.assertEqual(response.json()["generation"], "frigate-generation-1")
+        self.assertEqual(response.json()["dispatcher_identity"]["pid"], 10)
+        self.assertEqual(response.json()["fenced_cameras"], ["ipc_guardiao_portao"])
+
+    def test_post_starts_correlated_control_without_claiming_success(self):
+        with AuthTestClient(self.app) as client:
+            response = client.post(
+                "/recordings/control",
+                json={
+                    "camera": "front_door",
+                    "enabled": False,
+                    "operation_id": "private-operation-1",
+                    "purpose": "privacy",
+                },
+            )
+
+        self.assertEqual(response.status_code, 202)
+        self.assertEqual(response.json()["status"], "pending")
+        self.app.dispatcher.begin_recording_control.assert_called_once_with(
+            "front_door",
+            False,
+            "private-operation-1",
+            purpose="privacy",
+        )
+
+    def test_status_endpoint_returns_worker_receipts(self):
+        with AuthTestClient(self.app) as client:
+            response = client.get(
+                "/recordings/control/private-operation-1"
+            )
+
+        self.assertEqual(response.status_code, 200)
+        result = response.json()
+        self.assertEqual(result["status"], "applied")
+        self.assertEqual(
+            set(result["acks"]), {"camera_capture", "recording_maintainer"}
+        )
+
+    def test_refused_request_remains_a_conflict(self):
+        self.app.dispatcher.begin_recording_control.return_value = {
+            "status": "hold",
+            "reason": "recording_fenced",
+        }
+        with AuthTestClient(self.app) as client:
+            response = client.post(
+                "/recordings/control",
+                json={
+                    "camera": "front_door",
+                    "enabled": True,
+                    "operation_id": "normal-on-1",
+                    "purpose": "normal",
+                },
+            )
+
+        self.assertEqual(response.status_code, 409)
+        self.assertEqual(response.json()["status"], "hold")
+
+    def test_non_admin_cannot_read_or_control_recording_authority(self):
+        viewer = {"remote-user": "test_viewer", "remote-role": "viewer"}
+        with AuthTestClient(self.app) as client:
+            authority = client.get(
+                "/recordings/control/authority", headers=viewer
+            )
+            begin = client.post(
+                "/recordings/control",
+                headers=viewer,
+                json={
+                    "camera": "front_door",
+                    "enabled": False,
+                    "operation_id": "viewer-operation-1",
+                    "purpose": "privacy",
