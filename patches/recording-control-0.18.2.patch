+"""Validation helpers for correlated recording-writer stop barriers."""
+
+import hashlib
+import json
+import math
+import uuid
+from collections.abc import Mapping, Sequence
+from typing import Any
+
+
+def normalize_writer_identity(value: Any) -> dict[str, Any] | None:
+    """Return a canonical FFmpeg writer identity, or None if it is malformed."""
+    if not isinstance(value, Mapping):
+        return None
+    pid = value.get("pid")
+    created = value.get("created")
+    roles = value.get("roles")
+    if (
+        isinstance(pid, bool)
+        or not isinstance(pid, int)
+        or pid <= 0
+        or isinstance(created, bool)
+        or not isinstance(created, (int, float))
+        or not math.isfinite(created)
+        or not isinstance(roles, Sequence)
+        or isinstance(roles, (str, bytes))
+        or not roles
+        or any(not isinstance(role, str) or not role for role in roles)
+        or "record" not in roles
+        or len(set(roles)) != len(roles)
+    ):
+        return None
+    return {
+        "pid": pid,
+        "created": float(created),
+        "roles": sorted(roles),
+    }
+
+
+def writer_set_digest(values: Sequence[Any]) -> str | None:
+    """Hash a complete, duplicate-free set of writer process identities."""
+    if not isinstance(values, Sequence) or isinstance(values, (str, bytes)):
+        return None
+    normalized: list[dict[str, Any]] = []
+    for value in values:
+        identity = normalize_writer_identity(value)
+        if identity is None:
+            return None
+        normalized.append(identity)
+    normalized.sort(key=lambda item: (item["pid"], item["created"], item["roles"]))
+    keys = [(item["pid"], item["created"], tuple(item["roles"])) for item in normalized]
+    if len(keys) != len(set(keys)):
+        return None
+    encoded = json.dumps(normalized, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def validate_writer_exit_receipts(
+    expected_writers: Sequence[Any],
+    expected_digest: str,
+    receipts: Any,
+    *,
+    inventory_complete: Any,
+) -> bool:
+    """Require a one-to-one, observed exit receipt for every expected writer."""
+    if inventory_complete is not True or not isinstance(receipts, list):
+        return False
+    if writer_set_digest(expected_writers) != expected_digest:
+        return False
+    if writer_set_digest(receipts) != expected_digest:
+        return False
+    return all(
+        isinstance(receipt, Mapping)
+        and receipt.get("exit_observed") is True
+        and isinstance(receipt.get("exit_code"), int)
+        and not isinstance(receipt.get("exit_code"), bool)
+        for receipt in receipts
+    )
+
+
+def validate_drain_receipt(
+    receipt: Any,
+    *,
+    operation_id: str,
+    generation: str,
+    camera: str,
+    barrier_id: str,
+    writer_digest: str,
+    worker_instance: str,
+) -> bool:
+    """Validate that the maintainer completed the matching post-stop barrier."""
+    return (
+        isinstance(receipt, Mapping)
+        and receipt.get("phase") == "drain_complete"
+        and receipt.get("operation_id") == operation_id
+        and receipt.get("generation") == generation
+        and receipt.get("camera") == camera
+        and receipt.get("barrier_id") == barrier_id
+        and receipt.get("writer_set_digest") == writer_digest
+        and receipt.get("worker_instance") == worker_instance
+        and receipt.get("cache_clear") is True
+        and receipt.get("inflight_tasks") == 0
+        and isinstance(receipt.get("maintenance_sequence"), int)
+        and not isinstance(receipt.get("maintenance_sequence"), bool)
+        and receipt.get("maintenance_sequence", 0) > 0
+    )
+
+
+class RecordingOffBarrier:
+    """Enforce config -> writer exits -> post-exit drain ordering for one OFF."""
+
+    def __init__(
+        self,
+        operation_id: str,
+        generation: str,
+        camera: str,
+        expected_writers: Sequence[Any],
+        expected_digest: str,
+    ) -> None:
+        if writer_set_digest(expected_writers) != expected_digest:
+            raise ValueError("expected writer inventory is invalid")
+        self.operation_id = operation_id
+        self.generation = generation
+        self.camera = camera
+        self.expected_writers = [dict(item) for item in expected_writers]
+        self.expected_digest = expected_digest
+        self.phase = "config_pending"
+        self.barrier_id: str | None = None
+        self.writer_exit_receipts: list[dict[str, Any]] | None = None
+        self.reason: str | None = None
+
+    def accept_writers_stopped(
+        self, receipt: Any, *, expected_worker_instance: str, processes_exited: bool
+    ) -> bool:
+        """Accept only an exact, complete exit inventory for this operation."""
+        if self.phase != "config_pending":
+            return False
+        if (
+            not isinstance(receipt, Mapping)
+            or receipt.get("phase") != "writers_stopped"
+            or receipt.get("operation_id") != self.operation_id
+            or receipt.get("generation") != self.generation
+            or receipt.get("camera") != self.camera
+            or receipt.get("worker") != "camera_capture"
+            or receipt.get("worker_instance") != expected_worker_instance
+            or receipt.get("enabled") is not False
+            or receipt.get("applied") is not True
+            or receipt.get("inventory_complete") is not True
+            or receipt.get("writer_set_digest") != self.expected_digest
+            or receipt.get("record_processes") not in (None, [])
+            or processes_exited is not True
+        ):
+            return False
+        exits = receipt.get("writer_exit_receipts")
+        if not validate_writer_exit_receipts(
+            self.expected_writers,
+            self.expected_digest,
+            exits,
+            inventory_complete=True,
+        ):
+            return False
+        self.writer_exit_receipts = [dict(item) for item in exits]
+        self.barrier_id = uuid.uuid4().hex
+        self.phase = "writers_stopped"
+        return True
+
+    def accept_drain_complete(
+        self, receipt: Any, *, expected_worker_instance: str
+    ) -> bool:
+        """Accept the maintainer receipt only after the writer-stop phase."""
+        if self.phase != "writers_stopped" or self.barrier_id is None:
+            return False
+        if not validate_drain_receipt(
+            receipt,
+            operation_id=self.operation_id,
+            generation=self.generation,
+            camera=self.camera,
+            barrier_id=self.barrier_id,
+            writer_digest=self.expected_digest,
+            worker_instance=expected_worker_instance,
+        ):
+            return False
+        self.phase = "drain_complete"
+        return True
+
+    def invalidate(self, reason: str) -> None:
+        """Make this operation permanently ineligible for a positive receipt."""
+        self.phase = "hold_unreconciled"
+        self.reason = reason
