+"""Dependency-light tests for the recording stop/drain receipt contract."""
+
+import unittest
+
+from frigate.comms.recording_control_protocol import (
+    RecordingOffBarrier,
+    validate_drain_receipt,
+    validate_writer_exit_receipts,
+    writer_set_digest,
+)
+
+
+class TestRecordingControlBarrierProtocol(unittest.TestCase):
+    def setUp(self) -> None:
+        self.writers = [
+            {"pid": 101, "created": 1_000.25, "roles": ["detect", "record"]},
+            {"pid": 202, "created": 1_001.5, "roles": ["record"]},
+        ]
+        self.digest = writer_set_digest(self.writers)
+
+    def test_exit_receipts_must_match_complete_expected_set(self) -> None:
+        receipts = [
+            {**writer, "exit_observed": True, "exit_code": 0}
+            for writer in self.writers
+        ]
+        self.assertTrue(
+            validate_writer_exit_receipts(
+                self.writers,
+                self.digest,
+                receipts,
+                inventory_complete=True,
+            )
+        )
+
+    def test_missing_duplicate_or_unobserved_writer_exit_is_rejected(self) -> None:
+        base = [
+            {**writer, "exit_observed": True, "exit_code": 0}
+            for writer in self.writers
+        ]
+        for invalid in (
+            base[:1],
+            [*base, base[0]],
+            [{**base[0], "exit_observed": False}, base[1]],
+            [{**base[0], "exit_code": None}, base[1]],
+        ):
+            with self.subTest(invalid=invalid):
+                self.assertFalse(
+                    validate_writer_exit_receipts(
+                        self.writers,
+                        self.digest,
+                        invalid,
+                        inventory_complete=True,
+                    )
+                )
+
+    def test_empty_inventory_requires_an_explicit_complete_snapshot(self) -> None:
+        empty_digest = writer_set_digest([])
+        self.assertEqual(len(empty_digest), 64)
+        self.assertTrue(
+            validate_writer_exit_receipts(
+                [], empty_digest, [], inventory_complete=True
+            )
+        )
+        self.assertFalse(
+            validate_writer_exit_receipts(
