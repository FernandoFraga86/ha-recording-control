+            )
+        )
+        self.assertEqual(protocol.phase, "config_pending")
+
+        self.assertTrue(
+            protocol.accept_writers_stopped(
+                self._writer_stop_receipt(),
+                expected_worker_instance="capture-1",
+                processes_exited=True,
+            )
+        )
+        self.assertEqual(protocol.phase, "writers_stopped")
+        drain = dict(premature_drain, barrier_id=protocol.barrier_id)
+        self.assertTrue(
+            protocol.accept_drain_complete(
+                drain, expected_worker_instance="maintainer-1"
+            )
+        )
+        self.assertEqual(protocol.phase, "drain_complete")
+        self.assertFalse(
+            protocol.accept_writers_stopped(
+                self._writer_stop_receipt(),
+                expected_worker_instance="capture-1",
+                processes_exited=True,
+            )
+        )
+
+    def test_barrier_rejects_processes_not_confirmed_exited_and_stale_generation(self) -> None:
+        protocol = self._new_barrier()
+        self.assertFalse(
+            protocol.accept_writers_stopped(
+                self._writer_stop_receipt(),
+                expected_worker_instance="capture-1",
+                processes_exited=False,
+            )
+        )
+        stale = dict(self._writer_stop_receipt(), generation="old-generation")
+        self.assertFalse(
+            protocol.accept_writers_stopped(
+                stale,
+                expected_worker_instance="capture-1",
+                processes_exited=True,
+            )
+        )
+        self.assertEqual(protocol.phase, "config_pending")
+
+    def test_barrier_invalidation_is_terminal(self) -> None:
+        protocol = self._new_barrier()
+        protocol.invalidate("worker_restarted")
+        self.assertEqual(protocol.phase, "hold_unreconciled")
+        self.assertFalse(
+            protocol.accept_writers_stopped(
+                self._writer_stop_receipt(),
+                expected_worker_instance="capture-1",
+                processes_exited=True,
+            )
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
