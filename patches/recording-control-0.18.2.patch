+@unittest.skipUnless(os.name == "posix", "Frigate worker process test requires Linux")
+class TestLinuxRecordingWorkerProcessBarrier(unittest.TestCase):
+    def test_real_ffmpeg_exit_precedes_maintainer_drain_receipt(self) -> None:
+        ffmpeg_candidates = sorted(Path("/usr/lib/ffmpeg").glob("*/bin/ffmpeg"))
+        ffmpeg = next((path for path in reversed(ffmpeg_candidates) if path.is_file()), None)
+        if ffmpeg is None:
+            self.skipTest("pinned Frigate Linux image has no bundled FFmpeg executable")
+
+        temp_parent = os.environ.get("TMPDIR")
+        with tempfile.TemporaryDirectory(
+            prefix="frigate-recording-barrier-", dir=temp_parent
+        ) as temp_dir:
+            root = Path(temp_dir)
+            cache_dir = root / "cache"
+            recordings_dir = root / "recordings"
+            cache_dir.mkdir()
+            recordings_dir.mkdir()
+            segment = cache_dir / "guard@synthetic.mp4"
+            process = subprocess.Popen(
+                [
+                    str(ffmpeg),
+                    "-hide_banner",
+                    "-loglevel",
+                    "error",
+                    "-re",
+                    "-f",
+                    "lavfi",
+                    "-i",
+                    "testsrc=size=64x64:rate=2",
+                    "-an",
+                    "-c:v",
+                    "mpeg4",
+                    "-threads",
+                    "1",
+                    "-movflags",
+                    "+frag_keyframe+empty_moov",
+                    "-flush_packets",
+                    "1",
+                    "-t",
+                    "3600",
+                    "-f",
+                    "mp4",
+                    str(segment),
+                ],
+                stdin=subprocess.DEVNULL,
+                stdout=subprocess.DEVNULL,
+                stderr=subprocess.PIPE,
+                start_new_session=True,
+            )
+            try:
+                deadline = time.monotonic() + 30
+                while time.monotonic() < deadline:
+                    if process.poll() is not None:
+                        self.fail("synthetic FFmpeg exited before the OFF request")
+                    if segment.exists() and segment.stat().st_size > 0:
+                        break
+                    time.sleep(0.05)
+                self.assertTrue(segment.exists())
+                self.assertGreater(segment.stat().st_size, 0)
+
+                worker = object.__new__(CameraWatchdog)
+                worker.logger = logging.getLogger(__name__)
+                worker.config = SimpleNamespace(
+                    name="guard",
+                    enabled=True,
+                    record=SimpleNamespace(enabled=True),
+                    ffmpeg_cmds=[{"roles": ["record"]}],
+                )
+                worker.capture_thread = None
+                worker.ffmpeg_detect_process = process
+                worker.ffmpeg_detect_roles = ["record"]
+                worker.ffmpeg_detect_identity = CameraWatchdog._process_identity(
+                    process, ["record"]
+                )
+                writer_identity = worker.ffmpeg_detect_identity
+                worker.worker_instance = "camera-worker-1"
+                worker.ffmpeg_other_processes = []
+                worker.requestor = MagicMock()
+                worker.pending_recording_control_updates = []
+
+                writers, inventory_complete, configured_count = (
+                    worker._record_output_inventory()
+                )
+                self.assertTrue(inventory_complete)
+                self.assertEqual(configured_count, 1)
+                self.assertEqual(writers, [worker.ffmpeg_detect_identity])
+                digest = writer_set_digest(writers)
+                self.assertIsNotNone(digest)
+
+                stop_result = worker.stop_all_ffmpeg()
+                self.assertIsNotNone(process.poll())
+                self.assertTrue(stop_result["inventory_complete"])
+                self.assertEqual(
+                    stop_result["writer_exit_receipts"],
+                    [
+                        {
+                            **writer_identity,
+                            "exit_observed": True,
+                            "exit_code": process.returncode,
+                        }
+                    ],
+                )
+                worker._queue_recording_control_ack(
+                    "operation-1",
+                    "generation-1",
+                    False,
+                    writers,
+                    digest,
+                    writer_exit_receipts=stop_result["writer_exit_receipts"],
+                    inventory_complete=stop_result["inventory_complete"],
+                )
+                stopped_receipt = worker.requestor.send_data.call_args.args[1]
+                self.assertEqual(stopped_receipt["phase"], "writers_stopped")
+                self.assertTrue(stopped_receipt["inventory_complete"])
+                self.assertEqual(stopped_receipt["writer_exit_receipts"][0]["pid"], process.pid)
+
+                maintainer = object.__new__(RecordingMaintainer)
+                maintainer.requestor = MagicMock()
+                maintainer.requestor.send_data.side_effect = (
+                    lambda _topic, payload: {"operation_id": payload["operation_id"]}
+                )
+                maintainer.worker_instance = "maintainer-1"
+                maintainer.maintenance_sequence = 2
+                maintainer.inflight_recording_tasks = 0
+                maintainer.pending_recording_control_updates = {
+                    "guard": ("operation-1", "generation-1", False, writers, digest)
+                }
+                maintainer.pending_recording_drain_barriers = {
+                    "operation-1": (
+                        RecordingDrainBarrier(
+                            "operation-1",
+                            "generation-1",
+                            "guard",
+                            "barrier-1",
+                            digest,
+                            "maintainer-1",
+                        ),
+                        1,
+                    )
+                }
+
+                with patch("frigate.record.maintainer.CACHE_DIR", str(cache_dir)):
+                    maintainer._ack_pending_recording_drain_barriers("maintainer-1")
+                    maintainer.requestor.send_data.assert_not_called()
+                    self.assertIn("operation-1", maintainer.pending_recording_drain_barriers)
+
+                    shutil.move(str(segment), recordings_dir / segment.name)
+                    maintainer.maintenance_sequence += 1
+                    maintainer._ack_pending_recording_drain_barriers("maintainer-1")
+
+                drain_receipt = maintainer.requestor.send_data.call_args.args[1]
+                self.assertEqual(drain_receipt["phase"], "drain_complete")
+                self.assertEqual(drain_receipt["operation_id"], "operation-1")
+                self.assertEqual(drain_receipt["generation"], "generation-1")
+                self.assertEqual(drain_receipt["barrier_id"], "barrier-1")
+                self.assertEqual(drain_receipt["writer_set_digest"], digest)
+                self.assertFalse(maintainer.pending_recording_drain_barriers)
+            finally:
+                if process.poll() is None:
+                    process.kill()
+                    process.communicate()
+
+
+if __name__ == "__main__":
+    unittest.main()
