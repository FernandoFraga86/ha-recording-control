+class TestCameraWatchdogRecordingControl(unittest.TestCase):
+    def setUp(self) -> None:
+        self.worker = object.__new__(CameraWatchdog)
+        self.worker.config = MagicMock()
+        self.worker.config.name = "guard"
+        self.worker.config.enabled = True
+        self.worker.config.record.enabled = True
+        self.worker.worker_instance = "camera-worker-instance"
+        self.worker.requestor = MagicMock()
+        self.worker.pending_recording_control_updates = []
+        self.writer = {
+            "pid": os.getpid(),
+            "created": 1_000.0,
+            "roles": ["record"],
+        }
+        self.worker._record_output_inventory = MagicMock(
+            return_value=([self.writer], True, 1)
+        )
+        self.worker._ack_recording_control = MagicMock(
+            wraps=CameraWatchdog._ack_recording_control.__get__(self.worker)
+        )
+
+    def test_on_waits_for_valid_segment_after_request(self) -> None:
+        empty_digest = writer_set_digest([])
+        with patch("frigate.video.ffmpeg.time.time", return_value=1000.0):
+            self.worker._queue_recording_control_ack(
+                "on-1", "generation-1", True, [], empty_digest
+            )
+
+        self.worker._ack_recording_control.assert_not_called()
+        self.worker._ack_valid_recording_segment("guard", 999.0)
+        self.worker._ack_recording_control.assert_not_called()
+
+        self.worker._ack_valid_recording_segment("guard", 1001.0)
+        self.worker._ack_recording_control.assert_called_once()
+        args, kwargs = self.worker._ack_recording_control.call_args
+        self.assertEqual(args, ("on-1", "generation-1", True))
+        self.assertEqual(kwargs["recording_segment"]["camera"], "guard")
+        self.assertEqual(kwargs["recording_segment"]["start_time"], 1001.0)
+        self.assertEqual(self.worker.pending_recording_control_updates, [])
+        self.worker.requestor.send_data.assert_called_once()
+
+    def test_off_ack_contains_complete_exact_writer_exit_inventory(self) -> None:
+        digest = writer_set_digest([self.writer])
+        exited = {**self.writer, "exit_observed": True, "exit_code": -15}
+        self.worker._queue_recording_control_ack(
+            "off-1",
+            "generation-1",
+            False,
+            [self.writer],
+            digest,
+            writer_exit_receipts=[exited],
+            inventory_complete=True,
+        )
+
+        payload = self.worker.requestor.send_data.call_args.args[1]
+        self.assertEqual(payload["phase"], "writers_stopped")
+        self.assertEqual(payload["generation"], "generation-1")
+        self.assertEqual(payload["writer_exit_receipts"], [exited])
+        self.assertTrue(payload["inventory_complete"])
+        self.assertEqual(payload["record_processes"], [])
+
+    def test_off_ack_fails_closed_on_incomplete_or_wrong_writer_set(self) -> None:
+        digest = writer_set_digest([self.writer])
+        self.worker._queue_recording_control_ack(
+            "off-incomplete",
+            "generation-1",
+            False,
+            [self.writer],
+            digest,
+            writer_exit_receipts=[],
+            inventory_complete=False,
+        )
+        payload = self.worker.requestor.send_data.call_args.args[1]
+        self.assertFalse(payload["inventory_complete"])
+
+
+class TestRecordingMaintainerRecordingControl(unittest.TestCase):
+    def setUp(self) -> None:
+        self.worker = object.__new__(RecordingMaintainer)
+        self.worker.config = MagicMock()
+        camera = MagicMock()
+        camera.record.enabled = True
+        self.worker.config.cameras = {"guard": camera}
+        self.worker.requestor = MagicMock()
+        self.worker.requestor.send_data.side_effect = (
+            lambda _topic, payload: {"operation_id": payload["operation_id"]}
+        )
+        self.worker.worker_instance = "maintainer-1"
+        self.worker.maintenance_sequence = 4
+        self.worker.inflight_recording_tasks = 0
+        self.worker.pending_recording_control_updates = {}
+        self.worker.pending_recording_drain_barriers = {}
+
+    def test_on_receipt_is_after_completed_maintenance_cycle(self) -> None:
+        acknowledged = self.worker._ack_recording_control(
+            "guard", "on-1", "generation-1", True, "maintainer-1"
+        )
+        self.assertTrue(acknowledged)
+        payload = self.worker.requestor.send_data.call_args.args[1]
+        self.assertEqual(payload["phase"], "enabled")
+        self.assertEqual(payload["generation"], "generation-1")
+        self.assertEqual(payload["maintenance_sequence"], 4)
+        self.assertEqual(payload["inflight_tasks"], 0)
+
+    def test_off_drain_ack_requires_barrier_and_post_barrier_sweep(self) -> None:
+        writer_set = [{"pid": os.getpid(), "created": 1_000.0, "roles": ["record"]}]
+        digest = writer_set_digest(writer_set)
+        barrier = RecordingDrainBarrier(
+            "off-1", "generation-1", "guard", "barrier-1", digest, "maintainer-1"
+        )
+        self.worker.pending_recording_control_updates["guard"] = (
+            "off-1",
+            "generation-1",
+            False,
+            writer_set,
+            digest,
+        )
+        self.worker.pending_recording_drain_barriers["off-1"] = (barrier, 3)
+        self.worker.maintenance_sequence = 4
+        with patch.object(
+            RecordingMaintainer,
+            "_has_cached_recording_segments",
+            return_value=False,
+        ):
+            self.worker._ack_pending_recording_drain_barriers("maintainer-1")
+
+        payload = self.worker.requestor.send_data.call_args.args[1]
+        self.assertEqual(payload["phase"], "drain_complete")
+        self.assertEqual(payload["operation_id"], "off-1")
+        self.assertEqual(payload["barrier_id"], "barrier-1")
+        self.assertEqual(payload["maintenance_sequence"], 4)
+        self.assertEqual(self.worker.pending_recording_drain_barriers, {})
+        self.assertEqual(self.worker.pending_recording_control_updates, {})
+
+    def test_off_drain_ack_remains_pending_if_cache_is_not_clear(self) -> None:
+        digest = writer_set_digest([])
+        barrier = RecordingDrainBarrier(
+            "off-2", "generation-1", "guard", "barrier-2", digest, "maintainer-1"
+        )
+        self.worker.pending_recording_control_updates["guard"] = (
+            "off-2",
+            "generation-1",
+            False,
+            [],
+            digest,
+        )
+        self.worker.pending_recording_drain_barriers["off-2"] = (barrier, 1)
