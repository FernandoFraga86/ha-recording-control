+        worker: str,
+        enabled: bool,
+        *,
+        segment_valid: bool = True,
+        segment_start_offset: float = 0,
+    ) -> None:
+        process = psutil.Process(os.getpid())
+        requested_at = time.time() - 1
+        request = self.dispatcher._recording_control_requests[operation_id]
+        if enabled:
+            record_processes = [
+                {
+                    "pid": process.pid,
+                    "created": process.create_time(),
+                    "roles": ["record"],
+                }
+            ]
+            phase = "enabled"
+            extras = {
