+            }
+            recording_segment = None
+        else:
+            record_processes = []
+            phase = "drain_complete"
+            extras = {
+                "barrier_id": request["barrier_id"],
+                "writer_set_digest": request["writer_set_digest"],
+                "cache_clear": True,
+                "inflight_tasks": 0,
+                "maintenance_sequence": 1,
+            }
+            recording_segment = None
+        payload = {
+            "operation_id": operation_id,
+            "camera": "front_door",
+            "worker": worker,
+            "worker_instance": request["worker_instances"][worker],
+            "worker_identity": (
+                self.camera_worker_identity
+                if worker == "camera_capture"
+                else self.maintainer_identity
+            ),
+            "record_processes": record_processes,
+            "enabled": enabled,
+            "applied": True,
+            "recording_segment": recording_segment,
+            "phase": phase,
+            "generation": request["generation"],
+            **extras,
+        }
+        self.dispatcher._receive("recording_control/ack", payload)
