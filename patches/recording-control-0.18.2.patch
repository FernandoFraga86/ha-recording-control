+        with patch.object(
+            RecordingMaintainer,
+            "_has_cached_recording_segments",
+            return_value=True,
+        ):
+            self.worker._ack_pending_recording_drain_barriers("maintainer-1")
+
+        self.worker.requestor.send_data.assert_not_called()
+        self.assertIn("off-2", self.worker.pending_recording_drain_barriers)
