+                "inventory_complete": True,
+                "configured_record_output_count": 1,
+                "cache_sweep_complete": worker == "recording_maintainer",
+                "inflight_tasks": 0,
+                "maintenance_sequence": 1,
+            }
+            recording_segment = (
+                {
+                    "camera": "front_door",
+                    "start_time": requested_at + 1 + segment_start_offset,
+                    "requested_at": requested_at,
+                }
+                if worker == "camera_capture" and segment_valid
+                else None
+            )
+        elif worker == "camera_capture":
+            record_processes = []
+            phase = "writers_stopped"
+            self.synthetic_writer_exited = True
+            exits = [
