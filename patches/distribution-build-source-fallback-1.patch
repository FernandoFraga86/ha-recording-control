diff --git a/docker/main/build_nginx.sh b/docker/main/build_nginx.sh
--- a/docker/main/build_nginx.sh
+++ b/docker/main/build_nginx.sh
@@ -33,4 +33,10 @@
 mkdir /tmp/nginx-vod-module
-wget -nv https://github.com/kaltura/nginx-vod-module/archive/refs/tags/${VOD_MODULE_VERSION}.tar.gz
-tar -zxf ${VOD_MODULE_VERSION}.tar.gz -C /tmp/nginx-vod-module --strip-components=1
-rm ${VOD_MODULE_VERSION}.tar.gz
+VOD_MODULE_ARCHIVE="nginx-vod-module-${VOD_MODULE_VERSION}_GH0.tar.gz"
+VOD_MODULE_ARCHIVE_URL="https://download.freebsd.org/ports/distfiles/${VOD_MODULE_ARCHIVE}"
+VOD_MODULE_ARCHIVE_SHA256="ace04201cf2d2b1a3e5e732a22b92225b8ce61a494df9cc7f79d97efface8952"
+VOD_MODULE_ARCHIVE_SIZE="470904"
+wget -nv --output-document="$VOD_MODULE_ARCHIVE" "$VOD_MODULE_ARCHIVE_URL"
+test "$(stat -c %s "$VOD_MODULE_ARCHIVE")" = "$VOD_MODULE_ARCHIVE_SIZE"
+printf '%s  %s\n' "$VOD_MODULE_ARCHIVE_SHA256" "$VOD_MODULE_ARCHIVE" | sha256sum --check
+tar -zxf "$VOD_MODULE_ARCHIVE" -C /tmp/nginx-vod-module --strip-components=1
+rm "$VOD_MODULE_ARCHIVE"
